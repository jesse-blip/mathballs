<!DOCTYPE html>
<html>
<head>
    <title>Clean Finish Challenge</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@900&display=swap" rel="stylesheet">
    <style>
        :root { --bg: #f1efdb; --red: #cc0000; --gold: #ffcc00; --gray: #cccccc; }
        * { box-sizing: border-box; font-family: 'Roboto Condensed', sans-serif; }
        body { background: var(--bg); margin: 0; display: flex; align-items: center; justify-content: center; min-height: 100vh; overflow: hidden; }

        .lab-ui { background: white; border: 6px solid #000; padding: 25px; width: 950px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; box-shadow: 12px 12px 0px #000; }
        .setup-col { display: flex; flex-direction: column; gap: 8px; }
        .preview-col { background: #ddd; border: 4px dashed #888; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }
        
        .ball-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin: 10px 0; }
        .ball-opt { aspect-ratio: 1/1; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; color: white; font-weight: 900; font-size: 11px; border: 2px solid rgba(0,0,0,0.2); transition: 0.1s; }
        .ball-opt.active { border: 4px solid #000; transform: scale(1.1); }

        .btn-start { grid-column: span 2; padding: 15px; background: var(--gold); border: 6px solid #000; font-size: 2rem; font-weight: 900; cursor: pointer; text-transform: uppercase; }

        .screen { display: none; flex-direction: column; align-items: center; width: 100%; height: 100vh; justify-content: center; }
        .active { display: flex; }

        .header { text-align: center; font-size: 2.2rem; width: 850px; margin-bottom: 10px; line-height: 1; text-transform: uppercase; }
        #h-ball { -webkit-text-stroke: 1.5px black; font-size: 2.8rem; }

        #arena { width: 600px; height: 750px; background: #fff; border: 8px solid #000; position: relative; overflow: hidden; }
        #big-ball { position: absolute; background: var(--gray); border-radius: 50%; border: 2px solid #555; display: flex; align-items: center; justify-content: center; text-align: center; z-index: 2; overflow: hidden; }
        
        #hp-txt { 
            color: #fff; font-weight: 900; font-family: monospace; word-break: break-all; line-height: 0.8; padding: 10px;
            text-shadow: 2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 0 2px 0 #000, 0 -2px 0 #000, 2px 0 0 #000, -2px 0 0 #000;
        }

        #tiny-ball { position: absolute; border-radius: 50%; border: 4px solid #000; color: #fff; font-weight: 900; display: flex; align-items: center; justify-content: center; z-index: 3; text-shadow: 2px 2px 0px #000; font-size: 20px; }
        #damage-label { margin-top: 10px; font-size: 3.2rem; color: var(--gold); -webkit-text-stroke: 2px black; font-weight: 900; }
        
        .particle { position: absolute; border-radius: 50%; pointer-events: none; z-index: 5; }
        .dmg-pop { position: absolute; font-weight: 900; pointer-events: none; z-index: 10; -webkit-text-stroke: 1.5px #fff; animation: floatUp 0.8s forwards; font-size: 32px; }
        @keyframes floatUp { 0% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-100px); } }
    </style>
</head>
<body>

<div id="screen-lab" class="screen active">
    <div class="lab-ui">
        <div class="setup-col">
            <h1>CHALLENGE SETUP</h1>
            <input type="text" id="in-hp" style="width:100%; padding:8px; border:4px solid #000;" value="10^100">
            <input type="number" id="in-time" style="width:100%; padding:8px; border:4px solid #000;" value="58.1">
            
            <div class="ball-grid">
                <div class="ball-opt active" data-name="Doubler" style="background:#ff0000" onclick="sel(this,'mult',2,'x2')">x2</div>
                <div class="ball-opt" data-name="Tripler" style="background:#ff5500" onclick="sel(this,'mult',3,'x3')">x3</div>
                <div class="ball-opt" data-name="Quadrupler" style="background:#ffaa00" onclick="sel(this,'mult',4,'x4')">x4</div>
                <div class="ball-opt" data-name="Quintupler" style="background:#00ccff" onclick="sel(this,'mult',5,'x5')">x5</div>
                <div class="ball-opt" data-name="Sextupler" style="background:#0066ff" onclick="sel(this,'mult',6,'x6')">x6</div>
                <div class="ball-opt" data-name="Septupler" style="background:#00ff00" onclick="sel(this,'mult',7,'x7')">x7</div>
                <div class="ball-opt" data-name="Octupler" style="background:#55ff00" onclick="sel(this,'mult',8,'x8')">x8</div>
                <div class="ball-opt" data-name="Nonupler" style="background:#aaff00" onclick="sel(this,'mult',9,'x9')">x9</div>
                <div class="ball-opt" data-name="Decupler" style="background:#ffff00; color:#000" onclick="sel(this,'mult',10,'x10')">x10</div>
                <div class="ball-opt" data-name="Rooter" style="background:#000000" onclick="sel(this,'root',0,'√x')">√x</div>
                <div class="ball-opt" data-name="Halver" style="background:#777777" onclick="sel(this,'half',0,'x/2')">x/2</div>
                <div class="ball-opt" data-name="Quarter" style="background:#444444" onclick="sel(this,'quarter',0,'x/4')">x/4</div>
                <div class="ball-opt" data-name="Reverser" style="background:#6600ff" onclick="sel(this,'rev',0,'x/y')">x/y</div>
            </div>

            <label>BIG R</label><input type="range" min="50" max="260" value="120" id="sz-t" oninput="pre()">
            <label>PLAYER R</label><input type="range" min="15" max="100" value="40" id="sz-b" oninput="pre()">
        </div>
        <div class="preview-col"><div id="pre-t" style="background:#ccc; border-radius:50%"></div><div id="pre-b" style="border-radius:50%; border:3px solid #000; position:absolute; left:20px;"></div></div>
        <button class="btn-start" onclick="go()">START CHALLENGE</button>
    </div>
</div>

<div id="screen-game" class="screen">
    <div class="header">
        Can <span id="h-ball">BALL</span> <span id="h-sub">x2</span> Deal <span id="h-unit">Unit</span> Damage in <span id="h-tm">58.1</span>s?
    </div>
    <div id="arena">
        <div id="big-ball"><div id="hp-txt"></div></div>
        <div id="tiny-ball"></div>
    </div>
    <div id="damage-label">HIT: 0</div>
</div>

<script>
let hp = 0n, time = 0, last = 0, running = false;
const p = { x: 50, y: 50, dx: 14, dy: 14, r: 40, type: 'mult', val: 2n, lbl: 'x2', col: '#ff0000', pwr: 2n, hits: 1n, name: "Doubler" };
const t = { x: 250, y: 300, dx: 2, dy: 2, r: 120, mass: 6 };

const ILLIONS = ["", "Thousand", "Million", "Billion", "Trillion", "Quadrillion", "Quintillion", "Sextillion", "Septillion", "Octillion", "Nonillion", "Decillion", "Undecillion", "Duodecillion", "Tredecillion", "Quattuordecillion", "Quindecillion", "Sexdecillion", "Septendecillion", "Octodecillion", "Novemdecillion", "Vigintillion"];

const ctx = new (window.AudioContext || window.webkitAudioContext)();
function play(f, v, d) {
    const o = ctx.createOscillator(); const g = ctx.createGain();
    o.frequency.value = f; g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + d);
    o.connect(g); g.connect(ctx.destination); o.start(); o.stop(ctx.currentTime + d);
}

function explode(x, y, color) {
    for(let i=0; i<80; i++) {
        const div = document.createElement('div'); div.className = 'particle';
        div.style.background = color; div.style.width = div.style.height = (Math.random()*20+5)+"px";
        div.style.left = x+"px"; div.style.top = y+"px";
        document.getElementById('arena').appendChild(div);
        const ang = Math.random()*Math.PI*2; const dist = 50 + Math.random()*300;
        div.animate([{transform:'translate(0,0) scale(1)', opacity:1}, {transform:`translate(${Math.cos(ang)*dist}px,${Math.sin(ang)*dist}px) scale(0)`, opacity:0}], 1500);
        setTimeout(()=>div.remove(), 1500);
    }
}

function format(n) {
    if (n === 0n) return "0";
    const s = n.toString();
    if (s.length > 300) return "Infinity";
    if (s.length > 100) return (n / 10n**100n) + " Googol";
    let tier = Math.floor((s.length - 1) / 3);
    if (tier < 1) return s;
    let name = ILLIONS[tier] || "Unfathomable";
    return (n / 10n**BigInt(tier * 3)) + " " + name;
}

function pre() {
    const tr = document.getElementById('sz-t').value; const br = document.getElementById('sz-b').value;
    const pt = document.getElementById('pre-t'); const pb = document.getElementById('pre-b');
    pt.style.width = pt.style.height = (tr*2)+"px"; pb.style.width = pb.style.height = (br*2)+"px";
    pb.style.background = p.col; pb.innerText = p.lbl;
}

function sel(el, type, val, lbl) {
    document.querySelectorAll('.ball-opt').forEach(b => b.classList.remove('active'));
    el.classList.add('active'); p.type = type; p.val = BigInt(val); p.lbl = lbl; p.col = el.style.backgroundColor; 
    p.name = el.getAttribute('data-name'); pre();
}

function go() {
    const rawHp = document.getElementById('in-hp').value;
    hp = rawHp.includes('^') ? BigInt(rawHp.split('^')[0])**BigInt(rawHp.split('^')[1]) : BigInt(rawHp);
    time = parseFloat(document.getElementById('in-time').value)*1000;
    t.r = parseInt(document.getElementById('sz-t').value); p.r = parseInt(document.getElementById('sz-b').value);
    p.pwr = p.val || 1n; running = true; p.hits = 1n;

    const hBall = document.getElementById('h-ball');
    hBall.innerText = p.name.toUpperCase();
    hBall.style.color = p.col;
    document.getElementById('h-sub').innerText = p.lbl;
    document.getElementById('h-unit').innerText = format(hp) + " DAMAGE";
    
    document.getElementById('tiny-ball').style.background = p.col; 
    document.getElementById('tiny-ball').innerText = p.lbl;
    document.getElementById('tiny-ball').style.display = 'flex';
    document.getElementById('big-ball').style.display = 'flex';

    document.getElementById('screen-lab').classList.remove('active');
    document.getElementById('screen-game').classList.add('active');
    last = performance.now();
    loop();
}

function loop() {
    if(!running) return;
    const now = performance.now(); const dt = now - last; last = now; time -= dt;

    if (time <= 0 || hp <= 0n) {
        running = false;
        const bb = document.getElementById('big-ball');
        const tb = document.getElementById('tiny-ball');
        if(hp <= 0n) { 
            bb.style.display = 'none'; // Disappear
            explode(t.x+t.r, t.y+t.r, '#ccc'); play(100, 0.5, 0.8); 
        } else { 
            tb.style.display = 'none'; // Disappear
            explode(p.x+p.r, p.y+p.r, p.col); play(50, 0.5, 0.8); 
        }
        setTimeout(() => location.reload(), 2000); return;
    }

    document.getElementById('h-tm').innerText = (time/1000).toFixed(1);

    t.x += t.dx; t.y += t.dy;
    if (t.x <= 0 || t.x >= 600 - t.r*2) { t.dx *= -1; t.x = t.x <= 0 ? 1 : 599 - t.r*2; }
    if (t.y <= 0 || t.y >= 750 - t.r*2) { t.dy *= -1; t.y = t.y <= 0 ? 1 : 749 - t.r*2; }
    const bb = document.getElementById('big-ball');
    bb.style.left = t.x+"px"; bb.style.top = t.y+"px";
    bb.style.width = bb.style.height = (t.r*2)+"px";
    document.getElementById('hp-txt').innerText = hp.toString();
    document.getElementById('hp-txt').style.fontSize = Math.max(8, t.r/6) + "px";

    p.x += p.dx; p.y += p.dy;
    if (p.x <= 0 || p.x >= 600 - p.r*2) { p.dx *= -1; p.x = p.x <= 0 ? 1 : 599 - p.r*2; play(800, 0.1, 0.1); }
    if (p.y <= 0 || p.y >= 750 - p.r*2) { p.dy *= -1; p.y = p.y <= 0 ? 1 : 749 - p.r*2; play(800, 0.1, 0.1); }
    const tb = document.getElementById('tiny-ball');
    tb.style.left = p.x+"px"; tb.style.top = p.y+"px";
    tb.style.width = tb.style.height = (p.r*2)+"px";

    const dx = (p.x+p.r) - (t.x+t.r); const dy = (p.y+p.r) - (t.y+t.r);
    const dist = Math.sqrt(dx*dx + dy*dy);
    if (dist < (p.r + t.r)) {
        play(150, 0.4, 0.2);
        let dmg = 0n;
        if(p.type==='mult') { dmg = p.pwr; if(p.val > 0n) p.pwr *= p.val; }
        else if(p.type==='root') {
             let s = hp.toString();
             dmg = hp - BigInt(Math.floor(Math.sqrt(Number(s.substring(0,14))))) * 10n**BigInt(Math.max(0, s.length-14));
        }
        else if(p.type==='half') dmg = hp/2n;
        else if(p.type==='quarter') dmg = hp - (hp/4n);
        else if(p.type==='rev') { dmg = hp - (hp/(p.hits+1n)); p.hits++; }
        
        if (dmg >= hp) { dmg = hp; hp = 0n; } else { hp -= dmg; }
        
        document.getElementById('damage-label').innerText = "HIT: " + format(dmg);
        const pop = document.createElement('div'); pop.className = 'dmg-pop';
        pop.innerText = "-" + format(dmg); pop.style.left = p.x+"px"; pop.style.top = p.y+"px";
        pop.style.color = p.col;
        document.getElementById('arena').appendChild(pop); setTimeout(()=>pop.remove(), 800);

        const nx = dx/dist; const ny = dy/dist;
        const p1 = p.dx * nx + p.dy * ny;
        const p2 = t.dx * nx + t.dy * ny;
        const v1 = (p1 * (1 - t.mass) + 2 * t.mass * p2) / (1 + t.mass);
        const v2 = (p2 * (t.mass - 1) + 2 * 1 * p1) / (1 + t.mass);
        p.dx += (v1 - p1) * nx; p.dy += (v1 - p1) * ny;
        t.dx += (v2 - p2) * nx; t.dy += (v2 - p2) * ny;
        p.x += nx*10; p.y += ny*10;
    }
    requestAnimationFrame(loop);
}
pre();
</script>
</body>
</html>

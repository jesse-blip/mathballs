<!DOCTYPE html>
<html>
<head>
    <title>Math Simulation - Power Input</title>
    <style>
        body { background: #e0e0e0; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; font-family: 'Segoe UI', sans-serif; }
        
        #stats { text-align: center; margin-bottom: 15px; }
        /* Big Display is now just the Ball's Current Value */
        #ball-val-display { font-size: 3.5rem; font-weight: 900; color: #222; margin: 5px; min-height: 70px; font-family: monospace; }

        #arena { 
            width: 450px; height: 450px; background: white; 
            border: 12px solid #222; position: relative; overflow: hidden; 
        }

        #target {
            position: absolute; width: 110px; height: 110px; background: #cccccc; 
            border-radius: 50%; border: 5px solid #444; display: flex; 
            align-items: center; justify-content: center; font-weight: bold; 
            text-align: center; font-size: 16px; padding: 10px; box-sizing: border-box;
            word-break: break-all;
        }

        #active-ball {
            position: absolute; width: 55px; height: 55px; border-radius: 50%; 
            border: 3px solid #000; color: white; font-weight: bold; 
            display: none; align-items: center; justify-content: center; font-size: 20px;
        }

        #menu { margin-top: 25px; display: flex; gap: 12px; padding: 15px; background: #333; border-radius: 12px; }
        .menu-btn { width: 60px; height: 60px; border-radius: 50%; cursor: pointer; border: 2px solid white; color: white; font-weight: bold; }

        input { 
            padding: 8px; text-align: center; width: 320px; border: 3px solid #333; 
            border-radius: 6px; font-family: monospace; font-size: 1.2rem; font-weight: bold;
        }
    </style>
</head>
<body>

<div id="stats">
    <input type="text" id="hp-input" value="10^12" oninput="manualReset()">
    <div id="ball-val-display">0</div>
</div>

<div id="arena">
    <div id="target">
        <div id="t-hp">1,000,000,000,000</div>
    </div>
    <div id="active-ball"></div>
</div>

<div id="menu">
    <button class="menu-btn" style="background:#ff5722" onclick="setBall(2, '#ff5722')">2x</button>
    <button class="menu-btn" style="background:#2196f3" onclick="setBall(3, '#2196f3')">3x</button>
    <button class="menu-btn" style="background:#4caf50" onclick="setBall(4, '#4caf50')">4x</button>
    <button class="menu-btn" style="background:#ffeb3b; color:black" onclick="setBall(5, '#ffeb3b')">5x</button>
    <button class="menu-btn" style="background:#9c27b0" onclick="setBall(6, '#9c27b0')">6x</button>
</div>

<script>
let ballSpeed = 7.5;
const targetObj = { x: 170, y: 170, dx: 1.5, dy: 1.5, radius: 55 };
const ballObj = { x: 0, y: 0, dx: 0, dy: 0, active: false, currentPower: 0n, multiplier: 0n, radius: 27.5 };

// --- POWER PARSER ---
function parsePowerInput(input) {
    input = input.replace(/\s/g, '');
    if (input.includes('^')) {
        let parts = input.split('^');
        let base = BigInt(parts[0]);
        let exponent = parseInt(parts[1]);
        if (isNaN(exponent)) return 0n;
        return base ** BigInt(exponent);
    }
    try { return BigInt(input.replace(/,/g, '')); } catch(e) { return 0n; }
}

function manualReset() {
    document.getElementById('ball-val-display').innerText = "0";
    targetObj.x = 170; targetObj.y = 170;
    targetObj.dx = 1.5; targetObj.dy = 1.5;
    updateHPDisplay(parsePowerInput(document.getElementById('hp-input').value));
}

function updateHPDisplay(val) {
    let s = val.toString();
    document.getElementById('t-hp').innerText = s.length > 14 ? "10^" + (s.length - 1) : val.toLocaleString();
}

function setBall(m, color) {
    manualReset();
    ballObj.active = true;
    ballObj.multiplier = BigInt(m);
    ballObj.currentPower = BigInt(m);
    ballObj.x = 30; ballObj.y = 30;
    
    let angle = Math.random() * Math.PI * 2;
    ballObj.dx = Math.cos(angle) * ballSpeed;
    ballObj.dy = Math.sin(angle) * ballSpeed;
    
    const el = document.getElementById('active-ball');
    el.style.display = 'flex';
    el.style.background = color;
    el.innerText = m + "x";
    
    document.getElementById('ball-val-display').innerText = ballObj.currentPower.toString();
}

function run() {
    targetObj.x += targetObj.dx;
    targetObj.y += targetObj.dy;

    if(targetObj.x <= 0 || targetObj.x >= 340) targetObj.dx *= -1;
    if(targetObj.y <= 0 || targetObj.y >= 340) targetObj.dy *= -1;
    
    document.getElementById('target').style.left = targetObj.x + 'px';
    document.getElementById('target').style.top = targetObj.y + 'px';

    if(ballObj.active) {
        ballObj.x += ballObj.dx;
        ballObj.y += ballObj.dy;
        
        if(ballObj.x <= 0 || ballObj.x >= 395) ballObj.dx *= -1;
        if(ballObj.y <= 0 || ballObj.y >= 395) ballObj.dy *= -1;

        let bcX = ballObj.x + 27.5;
        let bcY = ballObj.y + 27.5;
        let tcX = targetObj.x + 55;
        let tcY = targetObj.y + 55;

        let dx = bcX - tcX;
        let dy = bcY - tcY;
        let distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < 82.5) {
            let currentVal = ballObj.currentPower;
            
            // UI Update: Ball's value (2, 4, 8 sequence)
            let vStr = currentVal.toString();
            document.getElementById('ball-val-display').innerText = vStr.length > 15 ? "10^" + (vStr.length - 1) : vStr;

            // Health Logic
            const maxHP = parsePowerInput(document.getElementById('hp-input').value);
            let remaining = maxHP - currentVal;
            updateHPDisplay(remaining > 0n ? remaining : 0n);

            // Preparation for next hit
            ballObj.currentPower = ballObj.currentPower * ballObj.multiplier;

            // Physics Impact
            let nx = dx / distance; 
            let ny = dy / distance; 
            targetObj.dx -= nx * 2; 
            targetObj.dy -= ny * 2;

            let dot = ballObj.dx * nx + ballObj.dy * ny;
            ballObj.dx = (ballObj.dx - 2 * dot * nx);
            ballObj.dy = (ballObj.dy - 2 * dot * ny);
            
            let angleShift = (Math.random() - 0.5) * 0.4;
            let newAngle = Math.atan2(ballObj.dy, ballObj.dx) + angleShift;
            ballObj.dx = Math.cos(newAngle) * ballSpeed;
            ballObj.dy = Math.sin(newAngle) * ballSpeed;

            ballObj.x += nx * 5; ballObj.y += ny * 5;
        }

        const bEl = document.getElementById('active-ball');
        bEl.style.left = ballObj.x + 'px';
        bEl.style.top = ballObj.y + 'px';
    }
    requestAnimationFrame(run);
}
run();
</script>
</body>
</html>
